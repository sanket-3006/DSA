// rhombus
        public static void rhombus(int n){
            for(int i = 1; i<=n; i++){
                for(int j = 1 ; j<=n-i ; j++){
                    System.out.print(" ");
                }
                for(int j = 1 ; j<=n; j++){
                    System.out.print("*");
                }
                System.out.println();
            }
            
        }



    // hollow rhombus
        public static void hollow_rhombus(int row , int col){
            for(int i =1; i<=row; i++){
                for(int j =1 ; j<=col-i ;j++){
                    System.out.print(" ");
                }
                for(int j = 1; j<=col ; j++){
                    if(i == 1 || i == row || j == 1 || j == col){
                        System.out.print("*");
                    }
                    else{
                        System.out.print(" ");
                    }
                }
                System.out.println();
            }
        }
