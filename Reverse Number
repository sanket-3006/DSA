public class forLoop {
    public static void main(String args []){

    // Print  reverse of a number 
         int n = 123;
         while(n>0){
             int lastdigit = n %10;
             System.out.print(lastdigit);
             n = n / 10;
         }


    // Reverse the given number
        int n = 9862;
        int rev = 0;

        while(n>0){
            int lastdigit = n % 10;
            rev = (rev * 10) + lastdigit;
            n = n / 10;
        }
        System.out.println(rev);
    }
}
