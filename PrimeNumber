import java.util.*;

public class prime {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number : ");
        int n = sc.nextInt();
        boolean isPrime  = true;
        if (n == 2 ){
            System.out.println("It is prime number.");
        }
        else{ //for(int i = 2 ; i<=n-1; i++) also we can write this
            for(int i = 2 ; i<n; i++){ // optimztion of the condition is "i<Math.sqrt(n)"
                if(n % i == 0){        //optimization means its check half of the number 
                    isPrime = false;  // n  = √n + √n  it is faster than n 
                }
            }

            if (isPrime == true){
                System.out.println("it is prime ");
            }
            else{
                System.out.println("it is not a prime number");
            }
        }
    }
}
